# Copy this file to `.env` (same folder) and fill in values. `.env` is git-ignored.
# Everything here is optional: without a key the dashboard runs fully, minus Claude features.

# Optional: enables Claude transcript analysis and grounded Q&A (server-side only; never sent to the browser).
# Create a key at https://console.anthropic.com/ — then also tick "Enable Claude" in Settings.
ANTHROPIC_API_KEY=

# Optional: default Claude model (can also be changed in Settings).
CLAUDE_MODEL=claude-opus-5-5

# API server port. The Vite dev server proxies /api to this port.
PORT=4000

# Keep 127.0.0.1 so private transcripts are not reachable from your network.
HOST=127.0.0.1

# Where the SQLite database and backups live (relative to the project root).
DB_PATH=data/db/learning.sqlite
BACKUP_DIR=data/backups

# Maximum transcript size accepted (bytes).
MAX_TRANSCRIPT_BYTES=2000000

# Optional: your Google Calendar "Secret address in iCal format" (Google Calendar → Settings →
# your calendar → Integrate calendar). Treat it like a password: it stays on the server and is
# never shown in the app, logged or exported. Lessons are the events whose title contains the
# keyword you set in Settings → Automation (default "Vibe Coding").
CALENDAR_ICS_URL=

# Optional: where Hearsay writes its log (defaults to %APPDATA%\Hearsay\logs). Used only to see
# whether a recording is running; transcribed text in the log is never read.
# HEARSAY_LOG_DIR=
